# Copy this file to .env and fill in your own values.

# Port the API listens on (Render sets this automatically in production)
PORT=5000

# MongoDB connection string from MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio

# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Secret key for reading detailed stats at GET /api/analytics/summary
# Use a long random string, e.g. run: node -e "console.log(crypto.randomUUID())"
ADMIN_KEY=change-me

NODE_ENV=development
